if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR is required")
endif()

set(version_file "${SOURCE_DIR}/cmake/ProductVersion.cmake")
if(NOT EXISTS "${version_file}")
  file(READ "${SOURCE_DIR}/CMakeLists.txt" root_cmake)
  string(REGEX MATCH "project\\(PianoAutoSustain VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)" _ "${root_cmake}")
  if(CMAKE_MATCH_1)
    message(FATAL_ERROR "Expected shared product version 1.0.0, current project version is ${CMAKE_MATCH_1}")
  endif()
  message(FATAL_ERROR "Expected shared product version file: ${version_file}")
endif()

include("${version_file}")
foreach(required PAS_VERSION_MAJOR PAS_VERSION_MINOR PAS_VERSION_PATCH PAS_VERSION_FULL PAS_VERSION_UI)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()

if(NOT PAS_VERSION_MAJOR EQUAL 1 OR NOT PAS_VERSION_MINOR EQUAL 0 OR NOT PAS_VERSION_PATCH EQUAL 0)
  message(FATAL_ERROR "Expected version tuple 1.0.0, got ${PAS_VERSION_MAJOR}.${PAS_VERSION_MINOR}.${PAS_VERSION_PATCH}")
endif()
if(NOT PAS_VERSION_FULL STREQUAL "1.0.0")
  message(FATAL_ERROR "Expected PAS_VERSION_FULL=1.0.0, got ${PAS_VERSION_FULL}")
endif()
if(NOT PAS_VERSION_UI STREQUAL "1.0")
  message(FATAL_ERROR "Expected PAS_VERSION_UI=1.0.0, got ${PAS_VERSION_UI}")
endif()

file(READ "${SOURCE_DIR}/CMakeLists.txt" root_cmake)
if(NOT root_cmake MATCHES "include\\(cmake/ProductVersion.cmake\\)")
  message(FATAL_ERROR "Root CMakeLists.txt does not include the shared product version")
endif()
string(FIND "${root_cmake}" [=[project(PianoAutoSustain VERSION ${PAS_VERSION_FULL}]=] project_version_use)
if(project_version_use EQUAL -1)
  message(FATAL_ERROR "Root project does not consume PAS_VERSION_FULL")
endif()

message(STATUS "Piano Auto Sustain version contract: ${PAS_VERSION_FULL} / UI ${PAS_VERSION_UI}")
